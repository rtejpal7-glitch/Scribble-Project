# Copy to speech-server/.env  (never commit .env)

# ---- Access ----
# Long random string; enter the same value in the app (Voice -> Settings).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SPEECH_SERVER_TOKEN=
# Listen address. 127.0.0.1 = this computer only. 0.0.0.0 = your network (token required).
SPEECH_HOST=127.0.0.1
SPEECH_PORT=8765
# Web origins allowed to call the server (your Vercel URL, local dev URLs).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://scribble-project.vercel.app
# Optional HTTPS (needed when the app is opened over https, e.g. from Vercel on an iPad):
# SSL_CERTFILE=certs/server.pem
# SSL_KEYFILE=certs/server-key.pem

# ---- Models (faster-whisper / CTranslate2 names, Hugging Face repo ids or local folders) ----
MODEL_EN=large-v3-turbo
MODEL_HI=large-v3-turbo
# Fine-tuned for Hindi-English code-switching, outputs romanized Hinglish.
# Community CTranslate2 conversion of Oriserve/Whisper-Hindi2Hinglish-Prime (Apache-2.0).
# See README "Converting a model yourself" to build it from the original weights.
MODEL_HINGLISH=Hub84/faster-whisper-hinglish-prime
HINGLISH_LANGUAGE=en
# Optional style prompts (empty = none). Vocabulary from the app is appended automatically.
# PROMPT_EN=Clinical notes dictated by an Indian doctor.
# PROMPT_HI=डॉक्टर द्वारा बोले गए क्लिनिकल नोट्स।
# PROMPT_HINGLISH=

# ---- Hardware ----
# auto | cuda | cpu
WHISPER_DEVICE=auto
# default | float16 (GPU) | int8_float16 (GPU, less memory) | int8 (CPU)
WHISPER_COMPUTE_TYPE=default
WHISPER_CPU_THREADS=0
# Where models are downloaded (default: Hugging Face cache)
# MODEL_DIR=models
BEAM_SIZE=5
# Load models at startup instead of on the first request
PRELOAD=1
MAX_AUDIO_SECONDS=60

# ---- Sentence check (suggests fixes like "Hi why am Rahul" -> "Hi I am Rahul") ----
# Uses a LOCAL language model so transcript text stays on this machine.
#   ollama             : install https://ollama.com, then  ollama pull qwen2.5:7b-instruct
#   openai-compatible  : llama.cpp server / LM Studio / vLLM on this machine
#   off                : disable
SUGGEST_BACKEND=ollama
# SUGGEST_URL=http://127.0.0.1:11434
# SUGGEST_MODEL=qwen2.5:7b-instruct
# SUGGEST_API_KEY=

# ---- Consultation reports (Voice tab -> Create report) ----
# Turns a dictated consultation into a clinical note + prescription, on the same
# local model server as the sentence check. A 7B model reads rough Hinglish much
# better than a 3B one:  ollama pull qwen2.5:7b-instruct
REPORT_MODEL=qwen2.5:7b-instruct
# REPORT_BACKEND=ollama        (defaults to SUGGEST_BACKEND; "off" disables reports)
# REPORT_URL=http://127.0.0.1:11434
