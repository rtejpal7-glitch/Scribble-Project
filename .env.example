# Copy to .env.local (never commit .env.local).

# ---- Server-side only (read by api/recognize.ts; NEVER prefix with VITE_) ----
# From https://cloud.myscript.com → your application → Keys
MYSCRIPT_APPLICATION_KEY=
MYSCRIPT_HMAC_KEY=
# Optional: override the MyScript endpoint (e.g. a self-hosted MyScript Server)
# MYSCRIPT_API_URL=https://cloud.myscript.com/api/v4.0/iink/batch
# Optional: extra origins allowed to call /api/recognize (comma separated). Same-origin is always allowed.
# ALLOWED_ORIGINS=https://clinicflow.example.com

# ---- Client-side (safe to expose) ----
# 'myscript' (default) or 'none' (notebook only, no recognition)
VITE_RECOGNITION_PROVIDER=myscript
# Writing pause before recognition runs, in ms (200–5000)
VITE_RECOGNITION_DEBOUNCE_MS=500
